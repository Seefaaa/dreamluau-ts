{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "types": ["byond-types/tg"]
  },
  "tstl": {
    "buildMode": "library",
    "luaTarget": "Luau",
    "noImplicitSelf": true,
    "luaLibImport": "require-minimal",
    "luaPlugins": [{ "name": "formatter" }]
  },
  "include": ["src"]
}
