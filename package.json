{
  "name": "dreamluau-ts",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/scripts/*"
  ],
  "scripts": {
    "build": "bun run --filter '@scripts/*' build",
    "build:formatter": "bun run --filter formatter build",
    "build:linter": "bun run --filter linter build",
    "build:zombie": "bun run --filter '@scripts/zombie' build",
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5"
  }
}
